MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=restaurant-pos

# Sarvam AI (menu import + bill template cloning). Add your key here, then restart the dev server.
# Create a key: https://indus.sarvam.ai/key-management
# Defaults: menu & bill use glm5.3-flash; sarvam-105b is the automatic fallback.
SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=glm5.3-flash
# SARVAM_MENU_MODEL=glm5.3-flash
# SARVAM_BILL_MODEL=glm5.3-flash
# SARVAM_OCR_LANGUAGE=en-IN
# SARVAM_REASONING_EFFORT=none
# SARVAM_MAX_TOKENS=2048
# SARVAM_BASE_URL=https://api.sarvam.ai

# Optional OCR fallback (legacy)
# OCR_SPACE_API_KEY=

HOTEL_CRON_SECRET=dev-cron-secret-change-me
# Razorpay (public booking + webhook). Without keys the public page books pay-at-hotel.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Guest messaging (optional; no keys → messages are skipped silently)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=HOTEL
