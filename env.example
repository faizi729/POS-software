MONGODB_URI=mongodb://localhost:27017/restaurant-pos
MONGODB_DB=restaurant-pos
JWT_SECRET=replace-with-a-long-random-string

# OCR.Space (Menu import from image)
# Get a key from OCR.Space, then paste it into your local .env as OCR_SPACE_API_KEY=...
OCR_SPACE_API_KEY=

# ── WhatsApp Cloud API ──
WHATSAPP_TOKEN=              # Meta permanent access token
WHATSAPP_PHONE_ID=           # Phone Number ID from Meta Business
WHATSAPP_VERIFY_TOKEN=       # Your chosen webhook verification token
WHATSAPP_CATALOG_ID=         # WhatsApp Business Catalog ID
WHATSAPP_RESTAURANT_ID=      # ObjectId of the restaurant this WA number belongs to

# ── Razorpay (for WhatsApp payments) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # Webhook secret for signature verification

# ── App ──
APP_BASE_URL=http://localhost:3000
