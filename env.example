MONGODB_URI=mongodb://localhost:27017/restaurant-pos
MONGODB_DB=restaurant-pos
# Required in production (Vercel/hosting env). Registration and login fail with 500 if missing.
JWT_SECRET=replace-with-a-long-random-string
MONGOOSE_DEBUG=false

# OCR.Space (Menu import from image — legacy fallback)
# Optional now: Sarvam AI is the primary OCR. Keep a key here only for the automatic fallback.
OCR_SPACE_API_KEY=

# ── Sarvam AI (menu import + bill template cloning) ──
# Create a key: https://indus.sarvam.ai/key-management
# Auth header used by this app: api-subscription-key
# Uses: Document AI "Sarvam Vision" parse (OCR) + Chat Completions (structured JSON)
SARVAM_API_KEY=
# Optional overrides (defaults shown)
# Model strategy (verified live against our menu + bill prompts):
#   menu & bill -> glm5.3-flash (fastest ~1s, exact numbers, 1M ctx, ₹13.5/45 per 1M tokens)
#   fallback    -> sarvam-105b  (used automatically if the chosen model is rejected)
#   sarvam-105b must use /v1; every other model uses /v2 (handled in code).
# SARVAM_CHAT_MODEL=glm5.3-flash
# SARVAM_MENU_MODEL=glm5.3-flash
# SARVAM_BILL_MODEL=glm5.3-flash
# SARVAM_OCR_LANGUAGE=en-IN              # BCP-47 (Sarvam defaults to Indic if omitted)
# SARVAM_REASONING_EFFORT=none           # "none" disables thinking (fast/cheap JSON)
# SARVAM_MAX_TOKENS=2048                 # raise if you see finish_reason=length
# SARVAM_DOC_MODEL=                      # LEAVE UNSET: "sarvam-vision" is rejected by parse (400 MODEL_INVALID)
# SARVAM_BASE_URL=https://api.sarvam.ai

# ── OpenRouter (optional AI fallback if SARVAM_API_KEY is not set) ──
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat

# ── WhatsApp Cloud API ──
WHATSAPP_TOKEN=              # Meta permanent access token
WHATSAPP_PHONE_ID=           # Phone Number ID from Meta Business
WHATSAPP_VERIFY_TOKEN=       # Your chosen webhook verification token
WHATSAPP_CATALOG_ID=         # WhatsApp Business Catalog ID
WHATSAPP_RESTAURANT_ID=      # ObjectId of the restaurant this WA number belongs to

# ── Razorpay (WhatsApp payment links + platform SaaS subscriptions) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # Same secret for /api/whatsapp/razorpay-webhook and /api/billing/razorpay/webhook

# Razorpay Plan IDs — 3 tiers × 2 intervals (create 6 Plans in Razorpay, one per line below)
RAZORPAY_PLAN_ID_STARTER_MONTHLY=
RAZORPAY_PLAN_ID_STARTER_YEARLY=
RAZORPAY_PLAN_ID_GROWTH_MONTHLY=
RAZORPAY_PLAN_ID_GROWTH_YEARLY=
RAZORPAY_PLAN_ID_SCALE_MONTHLY=
RAZORPAY_PLAN_ID_SCALE_YEARLY=
# Optional legacy: RAZORPAY_PLAN_ID_STARTER / _GROWTH / _SCALE (no suffix) = monthly if _MONTHLY is empty

# Optional: max billing cycles per subscription (invoices to generate)
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120          # monthly plans (default 120)
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_YEARLY=10   # yearly plans (default 10)

# ── App ──
APP_BASE_URL=http://localhost:3000

# ── Email (SMTP) — welcome email, login OTP, password reset ──
# Leave unset to skip sending (2FA and reset links require SMTP in production).
# Production: add SMTP_* in the hosting UI (Vercel → Settings → Environment Variables).
# Your local .env is not deployed; prod must define these again.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # use for port 465
# SMTP_REQUIRE_TLS=false   # only if your SMTP relay breaks STARTTLS on 587
# SMTP_DEBUG=1   # verbose SMTP log (server logs only); turn off after debugging
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Super Admin bootstrap (run `npm run sa:create`) ──
SA_EMAIL=admin@yourcompany.com
SA_PASSWORD=use-a-strong-password-12+
SA_NAME=Super Admin
SA_RESET=false

HOTEL_CRON_SECRET=dev-cron-secret-change-me
